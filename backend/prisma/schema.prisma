// Prisma schema for Jewellery Retail CRM — Phase 2 (Contacts + Channels)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  SALES
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum ActivityType {
  NOTE
  CALL
  VISIT
  STATUS_CHANGE
  ASSIGNMENT_CHANGE
  STAGE_CHANGE
  CREATED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeadChannel {
  OUTDOOR   // Door to Door, Mass Marketing, Referral, Campaign
  INSTORE   // Walk In
}

// ── Company ─────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  contacts Contact[]
}

// ── ContactType ──────────────────────────────────────────

model ContactType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
}

// ── Master Data ─────────────────────────────────────────

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  name       String
  role       Role      @default(SALES)
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id])
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  leads       Lead[]      @relation("AssignedStaff")
  contacts    Contact[]   @relation("ContactAssignee")
  customers   Customer[]  @relation("AssignedStaff")
  activities  Activity[]
  deals       Deal[]      @relation("DealOwner")
  visits      Visit[]

  dateOfBirth      DateTime?
  createdLeads     Lead[]     @relation("LeadCreator")
  feedbackServed   Feedback[] @relation("FeedbackSalesman")
  feedbackCalls    FeedbackRequest[] @relation("FeedbackRequestCompleter")
  advisedAppts     Appointment[]     @relation("AppointmentAdvisor")
  createdAppts     Appointment[]     @relation("AppointmentCreator")
  interactionLogs  InteractionLog[]  @relation("InteractionLogStaff")
  createdSegments  Segment[]         @relation("SegmentCreator")
  bridalAttendances BridalAttendee[] @relation("BridalAttendeeStaff")
  assignedTasks   Task[]             @relation("TaskAssignee")
  createdTasks    Task[]             @relation("TaskCreator")
  reminders        Reminder[] @relation("ReminderAssignee")
  createdReminders Reminder[] @relation("ReminderCreator")
  campaigns        Campaign[]
}

model Branch {
  id        String    @id @default(cuid())
  name      String
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  address   String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users     User[]
  leads     Lead[]
  customers Customer[]
  contacts  Contact[]
  areas     Area[]
  appointments Appointment[]

  @@unique([name, companyId])
}

model LeadSource {
  id             String      @id @default(cuid())
  name           String      @unique
  defaultChannel LeadChannel @default(OUTDOOR)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  leads Lead[]
}

model LeadStatus {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#6b7280")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leads Lead[]
}

model PipelineStage {
  leads     Lead[]
  id        String    @id @default(cuid())
  name      String    @unique
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  deals Deal[]
}

model LostReason {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  deals Deal[]
}

model CustomerCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  customers Customer[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique

  leads Lead[]
}

// ── Additional Master Tables ─────────────────────────────

model Area {
  id        String   @id @default(cuid())
  name      String   @unique
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  pincode   String?
  locations String?  // comma-separated location names
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Channel {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Contact — master person record ──────────────────────

model Contact {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  phone          String?
  email          String?
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  typeId         String?
  type           ContactType? @relation(fields: [typeId], references: [id])
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("ContactAssignee", fields: [assignedToId], references: [id])
  rating         Int?
  requiresReview Boolean      @default(false)
  isDuplicate    Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leads     Lead[]
  deals     Deal[]
  reminders Reminder[]
  visits    Visit[]
  tasks     Task[]
  appointments Appointment[]
  interactionLogs InteractionLog[]
  bridalAttendee  BridalAttendee?


  dateOfBirth     DateTime?
  anniversaryDate DateTime?
  state           String?
  city            String?
  pincode         String?

  @@unique([phone, companyId])
  @@index([branchId])
  @@index([assignedToId])
  @@index([phone])
}

// ── Core Entities ───────────────────────────────────────

model Lead {
  id            String      @id @default(cuid())
  contactId     String?
  contact       Contact?    @relation(fields: [contactId], references: [id])
  leadNo        Int         @default(autoincrement()) @unique
  feedbackRequests FeedbackRequest[]
  tasks            Task[]
  interactionLogs  InteractionLog[]
  channel       LeadChannel @default(OUTDOOR)
  firstName     String
  lastName      String
  email         String?
  phone         String?
  sourceId      String?
  source        LeadSource? @relation(fields: [sourceId], references: [id])
  statusId      String?
  status        LeadStatus? @relation(fields: [statusId], references: [id])
  branchId      String?
  branch        Branch?     @relation(fields: [branchId], references: [id])
  assignedToId  String?
  assignedTo    User?       @relation("AssignedStaff", fields: [assignedToId], references: [id])
  tags          Tag[]
  sentiment     Sentiment   @default(NEUTRAL)
  rating        Int?
  dueDate       DateTime?
  notes         String?
  altPhone       String?
  area           String?
  stageId        String?
  stage          PipelineStage? @relation(fields: [stageId], references: [id])
  priority       LeadPriority   @default(MEDIUM)
  marriageDate   DateTime?
  dnf            Boolean        @default(false)
  expectedWeight Float?
  expectedAmount Float?
  lossReason     String?
  createdById    String?
  createdBy      User?          @relation("LeadCreator", fields: [createdById], references: [id])
  isWon         Boolean     @default(false)
  isLost        Boolean     @default(false)
  isConverted   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer   Customer?
  deals      Deal[]
  visits     Visit[]
  activities Activity[]
  feedbacks  Feedback[]

  @@index([contactId])
  @@index([channel])
  @@index([branchId])
  @@index([assignedToId])
  @@index([statusId])
  @@index([stageId])
  @@index([priority])
  @@index([createdAt])
  @@index([createdById])
  @@index([marriageDate])
  @@index([dueDate])
}

model Customer {
  id            String            @id @default(cuid())
  leadId        String?           @unique
  lead          Lead?             @relation(fields: [leadId], references: [id])
  firstName     String
  lastName      String
  email         String?
  phone         String?
  categoryId    String?
  category      CustomerCategory? @relation(fields: [categoryId], references: [id])
  branchId      String?
  branch        Branch?           @relation(fields: [branchId], references: [id])
  assignedToId  String?
  assignedTo    User?             @relation("AssignedStaff", fields: [assignedToId], references: [id])
  rating        Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Deal {
  id                String         @id @default(cuid())
  contactId         String?
  contact           Contact?       @relation(fields: [contactId], references: [id])
  leadId            String?
  lead              Lead?          @relation(fields: [leadId], references: [id])
  stageId           String
  stage             PipelineStage  @relation(fields: [stageId], references: [id])
  value             Float          @default(0)
  expectedCloseDate DateTime?
  dueDate           DateTime?
  invoiceRef        String?
  lostReasonId      String?
  lostReason        LostReason?    @relation(fields: [lostReasonId], references: [id])
  ownerId           String?
  owner             User?          @relation("DealOwner", fields: [ownerId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([contactId])
  @@index([leadId])
  @@index([stageId])
  @@index([ownerId])
  @@index([expectedCloseDate])
  taskRefs Task[]
}

// ── Reminders ───────────────────────────────────────────

enum ReminderStatus {
  PENDING
  COMPLETED
}

model Reminder {
  id           String         @id @default(cuid())
  title        String
  description  String?
  dueDate      DateTime
  status       ReminderStatus @default(PENDING)
  assignedToId String?
  assignedTo   User?          @relation("ReminderAssignee", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?          @relation("ReminderCreator", fields: [createdById], references: [id])
  contactId    String?
  contact      Contact?       @relation(fields: [contactId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([assignedToId])
  @@index([dueDate])
  @@index([status])
}

// ── Campaigns ───────────────────────────────────────────

enum CampaignChannel {
  WHATSAPP
  SMS
  EMAIL
  CALL
}

enum CampaignStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
}

model Campaign {
  id             String          @id @default(cuid())
  name           String
  channel        CampaignChannel @default(WHATSAPP)
  targetSegment  String?
  scheduleDate   DateTime?
  description    String?
  status         CampaignStatus  @default(SCHEDULED)
  sentCount      Int             @default(0)
  deliveredCount Int             @default(0)
  convertedCount Int             @default(0)
  createdById    String?
  createdBy      User?           @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([scheduleDate])
}

// ── Feedback call queue ─────────────────────────────────

enum FeedbackRequestKind {
  REGISTRATION
  PURCHASE
}

enum FeedbackRequestStatus {
  PENDING
  COMPLETED
}

model FeedbackRequest {
  id              String                @id @default(cuid())
  leadId          String
  lead            Lead                  @relation(fields: [leadId], references: [id])
  kind            FeedbackRequestKind
  refNo           String?
  status          FeedbackRequestStatus @default(PENDING)
  attempts        Int                   @default(0)
  lastAttemptAt   DateTime?
  lastAttemptNote String?
  feedbackId      String?               @unique
  feedback        Feedback?             @relation(fields: [feedbackId], references: [id])
  completedAt     DateTime?
  completedById   String?
  completedBy     User?                 @relation("FeedbackRequestCompleter", fields: [completedById], references: [id])
  createdAt       DateTime              @default(now())

  @@index([status, createdAt])
  @@index([leadId])
}

// ── Bridal Attendee ──────────────────────────────────────

model BridalAttendee {
  id        String  @id @default(cuid())
  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id])
  userId    String
  user      User    @relation("BridalAttendeeStaff", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Customer Segments ───────────────────────────────────

model Segment {
  id          String    @id @default(cuid())
  name        String
  description String?
  branchId    String?
  criteria    Json
  matchAll    Boolean   @default(true)
  memberCount Int       @default(0)
  isActive    Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation("SegmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

// ── Interaction Logs ─────────────────────────────────────

enum InteractionChannel {
  CALL
  WHATSAPP
  EMAIL
  SMS
  IN_PERSON
  OTHER
}

model InteractionLog {
  id          String             @id @default(cuid())
  contactId   String?
  contact     Contact?           @relation(fields: [contactId], references: [id])
  leadId      String?
  lead        Lead?              @relation(fields: [leadId], references: [id])
  channel     InteractionChannel @default(CALL)
  notes       String?
  loggedById  String?
  loggedBy    User?              @relation("InteractionLogStaff", fields: [loggedById], references: [id])
  loggedAt    DateTime           @default(now())
  createdAt   DateTime           @default(now())

  @@index([contactId])
  @@index([leadId])
  @@index([loggedAt])
  @@index([channel])
}

// ── Appointments ─────────────────────────────────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id               String            @id @default(cuid())
  contactId        String?
  contact          Contact?          @relation(fields: [contactId], references: [id])
  branchId         String?
  branch           Branch?           @relation(fields: [branchId], references: [id])
  advisorId        String?
  advisor          User?             @relation("AppointmentAdvisor", fields: [advisorId], references: [id])
  createdById      String?
  createdBy        User?             @relation("AppointmentCreator", fields: [createdById], references: [id])
  appointmentType  String?
  appointmentDate  DateTime
  notes            String?
  status           AppointmentStatus @default(SCHEDULED)
  newCustomerName  String?
  newCustomerPhone String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([branchId])
  @@index([advisorId])
  @@index([appointmentDate])
  @@index([status])
}

// ── Tasks ────────────────────────────────────────────────

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id            String      @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime?
  reminderDate  DateTime?
  priority      LeadPriority @default(MEDIUM)
  status        TaskStatus   @default(PENDING)
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  dealId        String?
  deal          Deal?        @relation(fields: [dealId], references: [id])
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  visitId       String?
  visit         Visit?       @relation(fields: [visitId], references: [id])
  assignedToId  String?
  assignedTo    User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById   String?
  createdBy     User?        @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([assignedToId])
  @@index([dueDate])
  @@index([status])
}

// ── Lead-Linked Entities ────────────────────────────────

// ── Visit status (store footfall) ───────────────────────

enum VisitStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Visit {
  id        String    @id @default(cuid())
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id])
  contactId String?
  contact   Contact?  @relation(fields: [contactId], references: [id])
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  date      DateTime
  status          VisitStatus @default(IN_PROGRESS)
  counter         String?
  category        String?
  purpose         String?
  visitLocation   String?
  internalNotes   String?
  newVisitorName  String?
  newVisitorPhone String?
  @@index([contactId])
  @@index([date])
  notes     String?
  createdAt DateTime  @default(now())
  taskRefs  Task[]
}

model Activity {
  id          String       @id @default(cuid())
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id])
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  type        ActivityType
  description String
  createdAt   DateTime     @default(now())
}

model Feedback {
  request    FeedbackRequest?
  invoiceRef String?
  salesmanId String?
  salesman   User?   @relation("FeedbackSalesman", fields: [salesmanId], references: [id])
  @@index([createdAt])
  @@index([rating])
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime  @default(now())
}
