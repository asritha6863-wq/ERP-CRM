// Prisma schema for Jewellery Retail CRM — Phase 2 (Contacts + Channels)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  SALES
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum ActivityType {
  NOTE
  CALL
  VISIT
  STATUS_CHANGE
  ASSIGNMENT_CHANGE
  STAGE_CHANGE
  CREATED
}

enum LeadChannel {
  OUTDOOR   // Door to Door, Mass Marketing, Referral, Campaign
  INSTORE   // Walk In
}

// ── Company ─────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  contacts Contact[]
}

// ── ContactType ──────────────────────────────────────────

model ContactType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
}

// ── Master Data ─────────────────────────────────────────

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  name       String
  role       Role      @default(SALES)
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id])
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  leads       Lead[]      @relation("AssignedStaff")
  contacts    Contact[]   @relation("ContactAssignee")
  customers   Customer[]  @relation("AssignedStaff")
  activities  Activity[]
  deals       Deal[]      @relation("DealOwner")
  visits      Visit[]

  reminders        Reminder[] @relation("ReminderAssignee")
  createdReminders Reminder[] @relation("ReminderCreator")
}

model Branch {
  id        String    @id @default(cuid())
  name      String
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  address   String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users     User[]
  leads     Lead[]
  customers Customer[]
  contacts  Contact[]
  areas     Area[]

  @@unique([name, companyId])
}

model LeadSource {
  id             String      @id @default(cuid())
  name           String      @unique
  defaultChannel LeadChannel @default(OUTDOOR)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  leads Lead[]
}

model LeadStatus {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#6b7280")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leads Lead[]
}

model PipelineStage {
  id        String    @id @default(cuid())
  name      String    @unique
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  deals Deal[]
}

model LostReason {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  deals Deal[]
}

model CustomerCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  customers Customer[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique

  leads Lead[]
}

// ── Additional Master Tables ─────────────────────────────

model Area {
  id        String   @id @default(cuid())
  name      String   @unique
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  pincode   String?
  locations String?  // comma-separated location names
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Channel {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Contact — master person record ──────────────────────

model Contact {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  phone          String?
  email          String?
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  typeId         String?
  type           ContactType? @relation(fields: [typeId], references: [id])
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("ContactAssignee", fields: [assignedToId], references: [id])
  rating         Int?
  requiresReview Boolean      @default(false)
  isDuplicate    Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leads     Lead[]
  deals     Deal[]
  reminders Reminder[]

  @@unique([phone, companyId])
  @@index([branchId])
  @@index([assignedToId])
  @@index([phone])
}

// ── Core Entities ───────────────────────────────────────

model Lead {
  id            String      @id @default(cuid())
  contactId     String?
  contact       Contact?    @relation(fields: [contactId], references: [id])
  channel       LeadChannel @default(OUTDOOR)
  firstName     String
  lastName      String
  email         String?
  phone         String?
  sourceId      String?
  source        LeadSource? @relation(fields: [sourceId], references: [id])
  statusId      String?
  status        LeadStatus? @relation(fields: [statusId], references: [id])
  branchId      String?
  branch        Branch?     @relation(fields: [branchId], references: [id])
  assignedToId  String?
  assignedTo    User?       @relation("AssignedStaff", fields: [assignedToId], references: [id])
  tags          Tag[]
  sentiment     Sentiment   @default(NEUTRAL)
  rating        Int?
  dueDate       DateTime?
  isWon         Boolean     @default(false)
  isLost        Boolean     @default(false)
  isConverted   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer   Customer?
  deals      Deal[]
  visits     Visit[]
  activities Activity[]
  feedbacks  Feedback[]

  @@index([contactId])
  @@index([channel])
  @@index([branchId])
  @@index([assignedToId])
  @@index([statusId])
  @@index([dueDate])
}

model Customer {
  id            String            @id @default(cuid())
  leadId        String?           @unique
  lead          Lead?             @relation(fields: [leadId], references: [id])
  firstName     String
  lastName      String
  email         String?
  phone         String?
  categoryId    String?
  category      CustomerCategory? @relation(fields: [categoryId], references: [id])
  branchId      String?
  branch        Branch?           @relation(fields: [branchId], references: [id])
  assignedToId  String?
  assignedTo    User?             @relation("AssignedStaff", fields: [assignedToId], references: [id])
  rating        Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Deal {
  id                String         @id @default(cuid())
  contactId         String?
  contact           Contact?       @relation(fields: [contactId], references: [id])
  leadId            String?
  lead              Lead?          @relation(fields: [leadId], references: [id])
  stageId           String
  stage             PipelineStage  @relation(fields: [stageId], references: [id])
  value             Float          @default(0)
  expectedCloseDate DateTime?
  dueDate           DateTime?
  invoiceRef        String?
  lostReasonId      String?
  lostReason        LostReason?    @relation(fields: [lostReasonId], references: [id])
  ownerId           String?
  owner             User?          @relation("DealOwner", fields: [ownerId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([contactId])
  @@index([leadId])
  @@index([stageId])
  @@index([ownerId])
  @@index([expectedCloseDate])
}

// ── Reminders ───────────────────────────────────────────

enum ReminderStatus {
  PENDING
  COMPLETED
}

model Reminder {
  id           String         @id @default(cuid())
  title        String
  description  String?
  dueDate      DateTime
  status       ReminderStatus @default(PENDING)
  assignedToId String?
  assignedTo   User?          @relation("ReminderAssignee", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?          @relation("ReminderCreator", fields: [createdById], references: [id])
  contactId    String?
  contact      Contact?       @relation(fields: [contactId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([assignedToId])
  @@index([dueDate])
  @@index([status])
}

// ── Lead-Linked Entities ────────────────────────────────

model Visit {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  date      DateTime
  notes     String?
  createdAt DateTime  @default(now())
}

model Activity {
  id          String       @id @default(cuid())
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id])
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  type        ActivityType
  description String
  createdAt   DateTime     @default(now())
}

model Feedback {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime  @default(now())
}
